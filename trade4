function FormatAgeBreakerShortUUID(uuid)

    uuid =
        AgeBreakerNormalizeUUID(uuid)

    if uuid == "" then
        return "----"
    end

    if #uuid <= 4 then
        return uuid
    end

    return uuid:sub(#uuid - 3)
end

function FormatAgeBreakerPetLine(pet)

    if type(pet) ~= "table" then
        return "None"
    end

    local mutationPrefix =
        FormatAgeBreakerMutationPrefix(
            pet.MutationText
            or pet.Mutation
            or "Normal"
        )

    return mutationPrefix
        .. tostring(pet.PetName)
        .. " | Age "
        .. tostring(pet.Age or "Unknown")
        .. " | BW "
