function ResolveAgeBreakerHUDDefaultPosition()

    local x =
        tonumber(
            VisualState
            and VisualState.AgeBreakerHUDPositionX
        )

    local y =
        tonumber(
            VisualState
            and VisualState.AgeBreakerHUDPositionY
        )

    if x and y then
        return UDim2.fromOffset(
            math.floor(x),
            math.floor(y)
        )
    end

    return UDim2.new(
        0.5,
        -150,
        0,
        86
    )
end

function ClampAgeBreakerHUDPosition(frame, x, y)

    x =
        tonumber(x)
        or 0

    y =
        tonumber(y)
        or 0

    local parent =
        frame
        and frame.Parent

    local parentSize =
        parent
        and parent.AbsoluteSize

    local frameSize =
        frame
        and frame.AbsoluteSize

    if parentSize
    and frameSize then

        x =
            math.clamp(
                x,
                6,
                math.max(6, parentSize.X - frameSize.X - 6)
            )

        y =
            math.clamp(
                y,
                6,
                math.max(6, parentSize.Y - frameSize.Y - 6)
            )
    end

    return math.floor(x), math.floor(y)
end

function SaveAgeBreakerHUDPosition(frame)

    if not frame then
        return
    end

    local x, y =
        ClampAgeBreakerHUDPosition(
            frame,
            frame.AbsolutePosition.X,
            frame.AbsolutePosition.Y
        )

    if VisualState then

        VisualState.AgeBreakerHUDPositionX =
            x

        VisualState.AgeBreakerHUDPositionY =
            y
    end

    if type(MarkConfigDirty) == "function" then
        MarkConfigDirty()
    end
end

function MakeAgeBreakerHUDDraggable(frame, handle)

    if not frame
    or not handle then
        return
    end

    local dragging =
        false

    local dragInput =
        nil

    local dragStart =
        nil

    local startPosition =
        nil

    local connections =
        {}

    local function AddConnection(connection)

        if connection then
            table.insert(
                connections,
                connection
            )
        end
    end

    local function FinishDrag()

        if dragging == true then
            SaveAgeBreakerHUDPosition(frame)
        end

        dragging =
            false

        dragInput =
            nil

        dragStart =
            nil

        startPosition =
            nil
    end

    AddConnection(
        handle.InputBegan:Connect(function(input)

            if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            dragging =
                true

            dragStart =
                input.Position

            startPosition =
                frame.Position

            input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End
                or input.UserInputState == Enum.UserInputState.Cancel then
                    FinishDrag()
                end
            end)
        end)
    )

    AddConnection(
        handle.InputChanged:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                dragInput =
                    input
            end
        end)
    )

    AddConnection(
        UserInputService.InputChanged:Connect(function(input)

            if dragging ~= true
            or input ~= dragInput
            or not dragStart
            or not startPosition then
                return
            end

            local delta =
                input.Position - dragStart

            local newX =
                startPosition.X.Offset + delta.X

            local newY =
                startPosition.Y.Offset + delta.Y

            newX, newY =
                ClampAgeBreakerHUDPosition(
                    frame,
                    newX,
                    newY
                )

            frame.Position =
                UDim2.fromOffset(
                    newX,
                    newY
                )
        end)
    )

    AddConnection(
        UserInputService.InputEnded:Connect(function(input)

            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                FinishDrag()
            end
        end)
    )

    if frame.Destroying then

        AddConnection(
            frame.Destroying:Connect(function()

                for _, connection in ipairs(connections) do
                    pcall(function()
                        connection:Disconnect()
                    end)
                end

                table.clear(connections)
            end)
        )
    end
end

