local function FormatListingSetupValue(value, fallback)

    if value == nil then
        return tostring(fallback or "-")
    end

    local number =
        tonumber(value)

    if not number then
        return tostring(value)
    end

    if number % 1 == 0 then
        return tostring(math.floor(number))
    end

    return tostring(number)
end

