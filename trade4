ApplyWebhookPing = function(payload, pingText)

    pingText =
        tostring(pingText or "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")

    if pingText == "" then
        print("[WebhookPing] No ping")
        return payload
    end

    local allowedMentions = {}

    if pingText:lower() == "@everyone" then

        payload.content = "@everyone"

        allowedMentions.parse = {
            "everyone"
        }

    elseif pingText:lower() == "@here" then

        payload.content = "@here"

        allowedMentions.parse = {
            "everyone"
        }

    else

        local userId =
            pingText:match("<@!?(%d+)>")
            or pingText:match("@?(%d+)")

        if not userId then
            warn("[WebhookPing] Invalid ping:", pingText)
            return payload
        end

        payload.content =
            "<@" .. tostring(userId) .. ">"

        allowedMentions.users = {
            tostring(userId)
        }
    end

    payload.allowed_mentions =
        allowedMentions

    print(
        "[WebhookPing] Applied:",
        tostring(payload.content)
    )

    return payload
end

QueueWebhook = function(payload, routeOrURL)

    if type(payload) ~= "table" then
        warn("[Webhook] Invalid payload")
        return false
    end

    local targetURL =
        ""

    local routeUsed =
        "Main"

    local rawRouteOrURL =
        tostring(routeOrURL or "")

    if rawRouteOrURL:find("https://", 1, true) then

        targetURL =
            NormalizeWebhookURL(rawRouteOrURL)

        routeUsed =
            "Custom"

    else

        targetURL, routeUsed =
            ResolveWebhookRouteURL(rawRouteOrURL ~= "" and rawRouteOrURL or "Main")
    end

    if not CanSendWebhookToURL(targetURL) then
        return false
    end

    -- Internal routing metadata.
    -- SendWebhook strips this before JSON encoding.
    payload.__WebhookURL =
        targetURL

    payload.__WebhookRoute =
        routeUsed

    table.insert(
        WebhookState.Queue,
        payload
    )

    print(
        "[Webhook] Queued | Queue:",
        tostring(#WebhookState.Queue),
        "| Route:",
        tostring(routeUsed)
    )

    return true
end

--==================================================
-- WEBHOOK EMBED SEND
--==================================================

function SendWebhook(payload)

    if type(payload) ~= "table" then
        return false
    end

    local targetURL =
        NormalizeWebhookURL(
            payload.__WebhookURL
            or (
                WebhookState
                and WebhookState.URL
            )
        )

    if targetURL == "" then
        warn("[Webhook] Send failed: missing target URL")
        return false
    end

    local sendPayload =
        table.clone(payload)

    -- Remove internal routing fields before Discord receives the payload.
    sendPayload.__WebhookURL =
        nil

    sendPayload.__WebhookRoute =
        nil

    local body =
        HttpService:JSONEncode(sendPayload)

    local ok, response = pcall(function()

        return RequestFunction({

            Url =
                targetURL,

            Method = "POST",

            Headers = {
                ["Content-Type"] = "application/json"
            },

            Body = body
        })

    end)

    if not ok then
        warn("[WEBHOOK] REQUEST FAILED:", response)
        return
    end

    if type(response) == "table" then

        local statusCode =
            tonumber(
                response.StatusCode
                or response.status_code
                or response.Status
            )

        if statusCode == 200
        or statusCode == 204 then
            print("[WEBHOOK] Sent successfully:", tostring(statusCode))
            return
        end

        warn(
            "[WEBHOOK] BAD STATUS:",
            tostring(statusCode),
            tostring(response.Body or response.body or "")
        )

        return
    end

    print("[WEBHOOK] Request completed")
end

