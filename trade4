-- AUTO ACCEPT FRIEND REQUESTS
-- Event-driven. No polling interval.
-- Roblox friend request notification shape confirmed:
-- CoreGui.RobloxGui.NotificationFrame.Notification
--   NotificationText = "Sent you a friend request!"
--   Button1 = "Accept"
--   Button2 = "Decline"
--==================================================

function ReadHolyGuiText(instance)

    if not instance then
        return ""
    end

    local props = {
        "Text",
        "ContentText",
        "Name",
    }

    for _, prop in ipairs(props) do

        local ok, value =
            pcall(function()
                return instance[prop]
            end)

        if ok
        and type(value) == "string"
        and value ~= "" then

            value =
                value:gsub("%s+", " ")
                    :gsub("^%s+", "")
                    :gsub("%s+$", "")

            return value
        end
    end

    return ""
end

function FindHolyFriendNotificationRoot(instance)

    local current =
        instance

    local fallback =
        nil

    for _ = 1, 12 do

        if not current
        or current == CoreGui then
            break
        end

        local name =
            tostring(current.Name or ""):lower()

        if name == "notification"
        or name:find("notification", 1, true)
        or name:find("friend", 1, true) then
            fallback = current
        end

        local notificationText =
            current:FindFirstChild("NotificationText", true)

        if notificationText then
            return current
        end

        current =
            current.Parent
    end

    return fallback
end

function ClickHolyGuiButton(button)

    if not button then
        return false
    end

    local clicked =
        false

    pcall(function()

        if type(button.Activate) == "function" then
            button:Activate()
            clicked =
                true
        end
    end)

    if type(firesignal) == "function" then

        pcall(function()

            if button.MouseButton1Click then
                firesignal(button.MouseButton1Click)
                clicked =
                    true
            end
        end)
    end

    if type(getconnections) == "function" then

        pcall(function()

            local connections =
                getconnections(button.MouseButton1Click)

            if type(connections) == "table" then

                for _, connection in ipairs(connections) do

                    if type(connection.Fire) == "function" then
                        connection:Fire()
                        clicked =
                            true

                    elseif type(connection.Function) == "function" then
                        connection.Function()
                        clicked =
                            true
                    end
                end
            end
        end)
    end

    if not clicked then

        pcall(function()

            local virtualInput =
                game:GetService("VirtualInputManager")

            local position =
                button.AbsolutePosition

            local size =
                button.AbsoluteSize

            if not position
            or not size
            or size.X <= 0
            or size.Y <= 0 then
                return
            end

            local x =
                math.floor(position.X + size.X / 2)

            local y =
                math.floor(position.Y + size.Y / 2)

            virtualInput:SendMouseButtonEvent(
                x,
                y,
                0,
                true,
                game,
                0
            )

            task.wait(0.05)

            virtualInput:SendMouseButtonEvent(
                x,
                y,
                0,
                false,
                game,
                0
            )

            clicked = true
        end)
    end

    return clicked
end

