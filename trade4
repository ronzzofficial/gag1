local FailedTabBuilds =
    {}

local function BuildHolyTabStep(tabName, callback)

    tabName =
        tostring(tabName or "Unknown")

    if type(callback) ~= "function" then

        warn(
            "[UI BUILD] Missing builder:",
            tabName
        )

        table.insert(
            FailedTabBuilds,
            tabName .. ": missing builder"
        )

        return false
    end

    print(
        "[UI BUILD] Building:",
        tabName
    )

    local ok, err =
        xpcall(
            callback,
            debug.traceback
        )

    if not ok then

        warn(
            "[UI BUILD FAILED]",
            tabName,
            tostring(err)
        )

        table.insert(
            FailedTabBuilds,
            tabName .. ": " .. tostring(err)
        )

        return false
    end

    print(
        "[UI BUILD] Built:",
        tabName
    )

    return true
end

