        and boothsEvents:FindFirstChild("ClaimBooth")

    local RemoveBooth =
        boothsEvents
        and boothsEvents:FindFirstChild("RemoveBooth")

    local skinService =
        GameEvents:FindFirstChild("TradeBoothSkinService")

