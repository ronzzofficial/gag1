function RefreshHuntingStatusPanel()

    local state =
        TargetPetsHopState

    if type(state) ~= "table" then
        return
    end

    if type(RefreshHuntingTargetsPanel) == "function" then
        pcall(RefreshHuntingTargetsPanel)
    end

    local function SetLabel(label, text)

        if label
        and type(label.SetText) == "function" then

            label:SetText(
                tostring(text or "")
            )
        end
    end

    local targetCount =
        0

    if type(CountTargetPetsHopTargets) == "function" then
        targetCount =
            CountTargetPetsHopTargets()
    end

    local targets =
        {}

    if type(BuildTargetPetsHopTargetList) == "function" then
        targets =
            BuildTargetPetsHopTargetList()
    end

    local selectedText =
        tostring(targetCount)
        .. " pet"
        .. (
            targetCount == 1
            and ""
            or "s"
        )

    if #targets > 0 then

        local preview = {}

        for index = 1, math.min(#targets, 2) do
            table.insert(
                preview,
                targets[index]
            )
        end

        selectedText =
            selectedText
            .. " • "
            .. table.concat(preview, ", ")

        if #targets > 2 then
            selectedText =
                selectedText
                .. " +"
                .. tostring(#targets - 2)
        end
    end

    local hits =
        state.LastHits
        or {}

    local foundCount =
        #hits

    local lastTarget =
        foundCount > 0
        and tostring(foundCount) .. " target(s)"
        or "None"

    local lastOwner =
        foundCount > 0
        and (
            tostring(SafeNumber(state.LastBackpackCount, 0))
            .. " backpack • "
            .. tostring(SafeNumber(state.LastGoodListingCount, 0))
            .. " good • "
            .. tostring(SafeNumber(state.LastBadListingCount, 0))
            .. " bad"
        )
        or "None"

    local lastHopText =
        "--"

    local lastHop =
        tonumber(state.LastHop)

    if lastHop
    and lastHop > 0 then

        lastHopText =
            tostring(
                math.floor(
                    math.max(0, os.clock() - lastHop)
                    + 0.5
                )
            )
            .. "s ago"
    end

    local afkText

    if state.SellerAfkCheck == true then

        afkText =
            "On • "
            .. tostring(
                math.floor(
                    SafeNumber(
                        state.SellerAfkSeconds,
                        60
                    )
                )
            )
            .. "s"

        if state.LastAfkSkippedPlayer
        and state.LastAfkSkippedPet then

            afkText =
                afkText
                .. " • skipped "
                .. tostring(state.LastAfkSkippedPlayer)
        end
    else

        afkText =
            "Off"
    end

    SetLabel(
        HuntingModeLabel,
        state.Enabled == true
            and "Mode: Target Hunt"
            or "Mode: Standby"
    )

    SetLabel(
        HuntingSelectedLabel,
        "Selected: "
            .. selectedText
    )

    SetLabel(
        HuntingTargetLabel,
        "Found: "
            .. lastTarget
    )

    SetLabel(
        HuntingOwnerLabel,
        "Breakdown: "
            .. lastOwner
    )

    SetLabel(
        HuntingRuleLabel,
        "Stay Rule: "
            .. tostring(
                state.StayWhen
                or "Backpack Only OR Good Listing"
            )
    )

    SetLabel(
        HuntingHopDelayLabel,
        "No Target Delay: "
            .. tostring(
                math.floor(
                    SafeNumber(
                        state.NoTargetHopDelay,
                        10
                    )
                )
            )
            .. "s"
    )

    SetLabel(
        HuntingAfkLabel,
        "Seller AFK: "
            .. afkText
    )

    SetLabel(
        HuntingLastHopLabel,
        "Last Hop: "
            .. lastHopText
    )
end

