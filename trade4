--==================================================
-- WEIGHT RESOLUTION
--==================================================

function ResolveDisplayWeightFromBaseAge(baseWeight, age)

    baseWeight =
        tonumber(baseWeight)

    age =
        tonumber(age)

    if not baseWeight then
        return nil
    end

    if not age then
        age = 100
    end

    age =
        math.clamp(
            age,
            0,
            125
        )

    -- Grow a Garden calculator formula:
    -- DisplayWeight = Age0BaseWeight * (1 + 0.1 * Age)
    --
    -- Age 1   = x1.1
    -- Age 43  = x5.3
    -- Age 100 = x11
    -- Age 125 = x13.5
    local displayWeight =
        baseWeight * (1 + (0.1 * age))

    return math.floor(displayWeight * 100 + 0.5) / 100
end

function ResolveDisplayedWeight(baseWeight)

    -- Default fallback assumes Age 100.
    -- Calculator formula:
    -- DisplayWeight = Age0BaseWeight * (1 + 0.1 * Age)
    return ResolveDisplayWeightFromBaseAge(
        baseWeight,
        100
    ) or 0
end

function InferPetAgeFromBaseAndDisplayWeight(baseWeight, displayWeight)

    baseWeight =
        tonumber(baseWeight)

    displayWeight =
        tonumber(displayWeight)

    if not baseWeight
    or not displayWeight then
        return nil
    end

    if baseWeight <= 0
    or displayWeight <= 0 then
        return nil
    end

    -- Calculator formula:
    -- DisplayWeight = Age0BaseWeight * (1 + 0.1 * Age)
    -- Therefore:
    -- Age = ((DisplayWeight / BaseWeight) - 1) / 0.1
    local inferredAge =
        ((displayWeight / baseWeight) - 1) / 0.1

    if inferredAge ~= inferredAge
    or inferredAge == math.huge
    or inferredAge == -math.huge then
        return nil
    end

    inferredAge =
        math.floor(inferredAge + 0.5)

    if inferredAge < 0 then
        return nil
    end

    if inferredAge > 10000 then
        return nil
    end

    return inferredAge
end

function ResolveDisplayWeightFromBaseAndAge(baseWeight, age)

    return ResolveDisplayWeightFromBaseAge(
        baseWeight,
        age
    )
end

--==================================================
-- BOOTH LISTING CURRENT WEIGHT RESOLUTION
-- Used by market-snipes / market tracker.
--
-- Important:
-- Do NOT fake visible KG with BaseWeight * 11.
-- Visible/current KG changes with age/level, and the
-- old conversion creates impossible titles like:
-- Age 1 / 60 KG.
--
-- Priority:
-- 1. Explicit current/display weight from booth item data
-- 2. Raw base weight fallback
--==================================================

function ResolveBoothListingCurrentWeight(petData, itemData, listingData, resolvedAge)

    local baseWeight =
        tonumber(
            petData
            and (
                petData.BaseWeight
                or rawget(petData, "BaseWeight")
                or petData.baseWeight
                or rawget(petData, "baseWeight")
            )
        )

    local age =
        tonumber(resolvedAge)

    local sources = {
        petData,
        itemData,
        listingData,
    }

    local function EstimateFromBase()

        if not baseWeight then
            return nil
        end

        return ResolveDisplayWeightFromBaseAge(
            baseWeight,
            age
        )
    end

    for _, source in ipairs(sources) do

        if type(source) == "table" then

            local candidates = {
                source.DisplayWeight,
                rawget(source, "DisplayWeight"),

                source.displayWeight,
                rawget(source, "displayWeight"),

                source.CurrentWeight,
                rawget(source, "CurrentWeight"),

                source.currentWeight,
                rawget(source, "currentWeight"),

                source.KG,
                rawget(source, "KG"),

                source.Kg,
                rawget(source, "Kg"),

                source.Mass,
                rawget(source, "Mass"),

                source.mass,
                rawget(source, "mass"),

                -- Keep Weight last because this often appears to be raw BaseWeight.
                source.Weight,
                rawget(source, "Weight"),

                source.weight,
                rawget(source, "weight"),
            }

            for _, value in ipairs(candidates) do

                local number =
                    tonumber(value)

                if number then

                    -- If this value is just raw BaseWeight, calculate visible KG
                    -- using the actual pet Age/Level.
                    if baseWeight
                    and math.abs(number - baseWeight) < 0.001 then

                        return EstimateFromBase()
                            or number,
                            age and "EstimatedBaseAge" or "EstimatedBaseAgeUnknown"
                    end

                    return number, "Explicit"
                end
            end
        end
    end

    if baseWeight then

        return EstimateFromBase()
            or ResolveDisplayedWeight(baseWeight),
            age and "EstimatedBaseAge" or "EstimatedBaseAgeUnknown"
    end

    return 0, "Missing"
end

function ResolveBoothPetAge(petData, itemData, listingData)

    local bestAge =
        nil

    local bestSource =
        "Missing"

    local function ReadAgeValue(value, sourceName)

        local number =
            tonumber(value)

        if not number then
            return
        end

        number =
            math.floor(number)

        if number <= 0 then
            return
        end

        -- Do NOT cap at 100.
        -- Some pets can be age/level broken above 100.
        -- We still keep an anti-garbage ceiling so random timestamps,
        -- userIds, or huge internal counters do not become Age.
        if number > 10000 then
            return
        end

        if not bestAge
        or number > bestAge then

            bestAge =
                number

            bestSource =
                sourceName
        end
    end

    local function ScanTable(source, sourceName, depth)

        if type(source) ~= "table" then
            return
        end

        depth =
            tonumber(depth)
            or 0

        -- Direct known fields.
        -- In Grow a Garden pet data, Level is the visible Age.
        ReadAgeValue(rawget(source, "Level"), sourceName .. ".Level")
        ReadAgeValue(rawget(source, "level"), sourceName .. ".level")

        ReadAgeValue(rawget(source, "Age"), sourceName .. ".Age")
        ReadAgeValue(rawget(source, "age"), sourceName .. ".age")

        ReadAgeValue(rawget(source, "PetLevel"), sourceName .. ".PetLevel")
        ReadAgeValue(rawget(source, "petLevel"), sourceName .. ".petLevel")

        ReadAgeValue(rawget(source, "PetAge"), sourceName .. ".PetAge")
        ReadAgeValue(rawget(source, "petAge"), sourceName .. ".petAge")

        -- Only scan a few nested tables.
        -- This catches itemData.PetData.Level without making scanning expensive.
        if depth >= 2 then
            return
        end

        for key, value in pairs(source) do

            if type(value) == "table" then

                local nestedName =
                    sourceName
                    .. "."
                    .. tostring(key)

                ScanTable(
                    value,
                    nestedName,
                    depth + 1
                )
            end
        end
    end

    -- Priority order:
    -- petData first because petData.Level is the visible Age/Level.
    ScanTable(petData, "petData", 0)
    ScanTable(itemData, "itemData", 0)
    ScanTable(listingData, "listingData", 0)

    if bestAge then
        return bestAge, bestSource
    end

    return nil, "Missing"
end

function ResolveSeller(userId)

    if not userId then
        return "Unknown"
    end

    if SellerCache[userId] then
        return SellerCache[userId]
    end

    local ok, result = pcall(function()
        return Players:GetNameFromUserIdAsync(userId)
    end)

    if ok and result then
        SellerCache[userId] = result
        return result
    end

    return tostring(userId)
end

--==================================================
-- SHOWCASE AUTO SWITCH HELPERS
-- If selected showcase pet is gone/sold out, choose
-- another valid pet from Backpack/Character.
--==================================================

function NormalizeShowcasePetName(value)

    return tostring(value or "")
        :gsub("%b[]", "")
        :gsub("%s+", " ")
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

--==================================================
-- SHOWCASE AUTO SWITCH HELPERS
-- Auto Switch now only chooses pets currently listed
-- in your own booth, and only if the matching Tool is
-- still available in Backpack/Character to equip.
--==================================================

function BuildOwnListedShowcasePetNames()

    local output = {}

    --==================================================
    -- SOURCE 1: Own booth snapshot / own listed metadata
    -- This is more reliable for showcase switching because
    -- it represents pets HOLY already knows are listed by us.
    --==================================================

    if type(ListingsState) == "table" then

        local snapshot =
            ListingsState.OwnBoothSnapshot

        if type(snapshot) == "table" then

            for _, listing in pairs(snapshot) do

                if type(listing) == "table" then

                    local petName =
                        NormalizeShowcasePetName(
                            listing.PetName
                            or listing.Name
                            or listing.ToolName
                            or listing.ItemName
                            or ""
                        )

                    if petName ~= "" then
                        output[petName] =
                            true
                    end
                end
            end
        end

        local metadata =
            ListingsState.OwnListedMetadata

        if type(metadata) == "table" then

            for _, data in pairs(metadata) do

                if type(data) == "table" then

                    local petName =
                        NormalizeShowcasePetName(
                            data.PetName
                            or data.ToolName
                            or data.Name
                            or ""
                        )

                    if petName ~= "" then
                        output[petName] =
                            true
                    end
                end
            end
        end
    end

    -- If we already found own listed pets from local state,
    -- use that immediately.
    for _ in pairs(output) do
        return output
    end

    --==================================================
    -- SOURCE 2: LatestBoothData fallback
    -- More defensive than the old version.
    --==================================================

    local data =
        LatestBoothData

    local localPlayer =
        Players.LocalPlayer

    if not data
    or type(data.Booths) ~= "table"
    or type(data.Players) ~= "table"
    or not localPlayer then
        return output
    end

    local localUserId =
        tostring(localPlayer.UserId)

    local possibleOwnerKeys = {}

    for _, boothData in pairs(data.Booths) do

        if type(boothData) ~= "table" then
            continue
        end

        local owner =
            boothData.Owner
            or boothData.UserId
            or boothData.Player
            or boothData.PlayerId

        local ownerText =
            tostring(owner or "")

        if ownerText ~= ""
        and ownerText:find(localUserId, 1, true) then

            possibleOwnerKeys[ownerText] =
                true

            if boothData.Owner then
                possibleOwnerKeys[tostring(boothData.Owner)] =
                    true
            end
        end
    end

    for ownerKey in pairs(possibleOwnerKeys) do

        local playerData =
            data.Players[ownerKey]

        if type(playerData) ~= "table"
        or type(playerData.Listings) ~= "table"
        or type(playerData.Items) ~= "table" then
            continue
        end

        for _, listingData in pairs(playerData.Listings) do

            if type(listingData) ~= "table"
            or listingData.ItemType ~= "Pet" then
                continue
            end

            local itemId =
                listingData.ItemId

            local itemData =
                playerData.Items[itemId]

            if type(itemData) ~= "table" then
                continue
            end

            local petName =
                NormalizeShowcasePetName(
                    itemData.PetType
                    or itemData.PetName
                    or itemData.Name
                    or ""
                )

            if petName ~= "" then
                output[petName] =
                    true
            end
        end
    end

    return output
end

function ShowcaseToolMatchesListedPet(parsedPetName, listedPetName)

    parsedPetName =
        NormalizeShowcasePetName(parsedPetName)

    listedPetName =
        NormalizeShowcasePetName(listedPetName)

    if parsedPetName == ""
    or listedPetName == "" then
        return false
    end

    local parsedLower =
        parsedPetName:lower()

    local listedLower =
        listedPetName:lower()

    if parsedLower == listedLower then
        return true
    end

    -- Allows mutation-prefixed tools:
    -- "Rainbow Dilophosaurus" matches listed base "Dilophosaurus".
    if #parsedLower > #listedLower
    and parsedLower:sub(-#listedLower) == listedLower then
        return true
    end

    return false
end

function BuildAvailableShowcasePets()

    local player =
        Players.LocalPlayer

    if not player then
        return {}
    end

    local listedPets =
        BuildOwnListedShowcasePetNames()

    local hasListedSnapshot =
        false

    for _ in pairs(listedPets or {}) do
        hasListedSnapshot =
            true

        break
    end

    if hasListedSnapshot ~= true then
        return {}
    end

    local containers = {
        player.Character,
        player:FindFirstChild("Backpack"),
    }

    local pets =
        {}

    local seenKeys =
        {}

    for _, container in ipairs(containers) do

        if not container then
            continue
        end

        for _, child in ipairs(container:GetChildren()) do

            if not child:IsA("Tool") then
                continue
            end

            local parsed =
                ParsePetTool(child)

            if not parsed then
                continue
            end

            local parsedPetName =
                NormalizeShowcasePetName(
                    parsed.PetName
                )

            local weight =
                tonumber(parsed.Weight)
                or 0

            if parsedPetName == ""
            or weight <= 0 then
                continue
            end

            local matchedListedPet =
                nil

            for listedPetName in pairs(listedPets or {}) do

                if ShowcaseToolMatchesListedPet(
                    parsedPetName,
                    listedPetName
                ) then

                    matchedListedPet =
                        listedPetName

                    break
                end
            end

            -- Simple showcase rule:
            -- if it is not confirmed listed in your booth, do not show it.
            if not matchedListedPet then
                continue
            end

            local stableKey =
                tostring(
                    parsed.StableKey
                    or parsed.UID
                    or child.Name
                )

            if stableKey == ""
            or seenKeys[stableKey] then
                continue
            end

            seenKeys[stableKey] =
                true

            table.insert(pets, {
                Tool = child,

                PetName = parsedPetName,
                ListedPetName = matchedListedPet,

                IsListed = true,

                Weight = weight,
                UID = parsed.UID,

                StableKey = stableKey,
            })
        end
    end

    return SortShowcasePetsForUI(pets)
end

--==================================================
-- SHOWCASE ROTATION HELPERS
-- Multi-select listed-pet rotation for Booth Showcase.
--==================================================

function NormalizeShowcaseMode(value)

    return "Selected Listed Rotation"
end

function NormalizeShowcaseSwitchMode(value)

    return "Next Selected Listed Pet"
end

function FormatShowcaseShortUID(uid)

    uid =
        tostring(uid or "")

    if uid == "" then
        return "----"
    end

    if #uid <= 4 then
        return uid
    end

    return uid:sub(#uid - 3)
end

function FormatShowcasePetChoice(pet)

    if type(pet) ~= "table" then
        return "Unknown"
    end

    return tostring(pet.PetName or "Unknown")
        .. " | "
        .. string.format(
            "%.2f KG",
            tonumber(pet.Weight) or 0
        )
        .. " | #"
        .. FormatShowcaseShortUID(
            pet.UID or pet.StableKey
        )
end

function SortShowcasePetsForUI(pets)

    table.sort(pets, function(a, b)

        local aName =
            tostring(a.PetName or ""):lower()

        local bName =
            tostring(b.PetName or ""):lower()

        if aName ~= bName then
            return aName < bName
        end

        local aWeight =
            tonumber(a.Weight)
            or 0

        local bWeight =
            tonumber(b.Weight)
            or 0

        if aWeight ~= bWeight then
            return aWeight > bWeight
        end

        return tostring(a.StableKey or "")
            < tostring(b.StableKey or "")
    end)

    return pets
end

function BuildShowcasePetChoiceMaps()

    local pets =
        SortShowcasePetsForUI(
            BuildAvailableShowcasePets()
        )

    local choices = {}
    local choiceToKey = {}
    local keyToChoice = {}
    local keyToPet = {}

    for _, pet in ipairs(pets) do

        local stableKey =
            tostring(
                pet.StableKey
                or pet.UID
                or pet.PetName
                or ""
            )

        if stableKey ~= "" then

            local choice =
                FormatShowcasePetChoice(pet)

            -- Prevent duplicate display rows from overwriting each other.
            if choiceToKey[choice] then
                choice =
                    choice
                    .. " | "
                    .. tostring(#choices + 1)
            end

            table.insert(
                choices,
                choice
            )

            choiceToKey[choice] =
                stableKey

            keyToChoice[stableKey] =
                choice

            keyToPet[stableKey] =
                pet
        end
    end

    ShowcaseChoiceToStableKey =
        choiceToKey

    ShowcaseStableKeyToChoice =
        keyToChoice

    return choices, choiceToKey, keyToPet
end

function FormatSavedShowcaseChoiceLabel(identity, statusText)

    if type(identity) ~= "table" then
        return nil
    end

    local petName =
        NormalizeShowcasePetName(
            identity.PetName
            or identity.ListedPetName
        )

    if petName == "" then
        petName =
            "Saved Pet"
    end

    local weight =
        tonumber(identity.Weight)
        or 0

    local uid =
        tostring(
            identity.UID
            or identity.StableKey
            or ""
        )

    local label =
        petName

    if weight > 0 then
        label =
            label
            .. " | "
            .. string.format("%.2f KG", weight)
    end

    if uid ~= "" then
        label =
            label
            .. " | #"
            .. FormatShowcaseShortUID(uid)
    end

    statusText =
        tostring(statusText or "")

    if statusText ~= "" then
        label =
            label
            .. " | "
            .. statusText
    end

    return label
end

function BuildSavedShowcaseChoiceLabels(statusText)

    local labels =
        {}

    statusText =
        tostring(statusText or "saved")

    if type(BoothPetState.SavedShowcaseSelections) == "table"
    and #BoothPetState.SavedShowcaseSelections > 0 then

        for _, identity in ipairs(BoothPetState.SavedShowcaseSelections) do

            local label =
                FormatSavedShowcaseChoiceLabel(
                    identity,
                    statusText
                )

            if label
            and label ~= "" then

                table.insert(
                    labels,
                    label
                )
            end
        end

        table.sort(labels)

        return labels
    end

    -- First-time fallback before save file exists.
    if type(BoothPetState.SelectedShowcasePetLabels) == "table" then

        for _, label in ipairs(BoothPetState.SelectedShowcasePetLabels) do

            label =
                tostring(label or "")

            if label ~= "" then
                table.insert(
                    labels,
                    label
                )
            end
        end
    end

    table.sort(labels)

    return labels
end

function MergeSavedShowcaseLabelsIntoChoices(choices)

    choices =
        type(choices) == "table"
        and choices
        or {}

    local existing =
        {}

    for _, choice in ipairs(choices) do
        existing[tostring(choice)] =
            true
    end

    BoothPetState.SelectedShowcasePets =
        BoothPetState.SelectedShowcasePets
        or {}

    for _, identity in ipairs(BoothPetState.SavedShowcaseSelections or {}) do

        local stableKey =
            tostring(
                identity.StableKey
                or identity.UID
                or ""
            )

        if stableKey == "" then
            continue
        end

        -- If this exact saved pet is already present as a real listed choice,
        -- do not add a placeholder duplicate.
        local realLabel =
            ShowcaseStableKeyToChoice
            and ShowcaseStableKeyToChoice[stableKey]

        if realLabel
        and realLabel ~= "" then

            BoothPetState.SelectedShowcasePets[stableKey] =
                true

            continue
        end

        local label =
            FormatSavedShowcaseChoiceLabel(
                identity,
                "missing"
            )

        if label
        and label ~= ""
        and not existing[label] then

            table.insert(
                choices,
                label
            )

            existing[label] =
                true
        end

        -- Temporary mapping for Obsidian multi-select.
        -- This lets the saved/missing row stay selected visually.
        if label
        and label ~= "" then

            ShowcaseChoiceToStableKey[label] =
                ShowcaseChoiceToStableKey[label]
                or stableKey

            ShowcaseStableKeyToChoice[stableKey] =
                ShowcaseStableKeyToChoice[stableKey]
                or label
        end
    end

    return choices
end

--==================================================
-- SHOWCASE SELECTION PERSISTENCE
-- Saves selected showcase pets by identity, not only
-- by dropdown label, so it survives rejoin/teleport.
--==================================================

SHOWCASE_SAVE_FOLDER =
    "HolyV2"

SHOWCASE_SAVE_FILE =
    "HolyV2/ShowcasePets.json"

function CanUseShowcaseFileIO()

    return type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
end

function EnsureShowcaseSaveFolder()

    if type(makefolder) ~= "function"
    or type(isfolder) ~= "function" then
        return false
    end

    local ok =
        pcall(function()

            if not isfolder(SHOWCASE_SAVE_FOLDER) then
                makefolder(SHOWCASE_SAVE_FOLDER)
            end
        end)

    return ok == true
end

function BuildShowcaseIdentityFromPet(pet)

    if type(pet) ~= "table" then
        return nil
    end

    local tool =
        pet.Tool

    return {
        PetName =
            NormalizeShowcasePetName(
                pet.PetName
            ),

        ListedPetName =
            NormalizeShowcasePetName(
                pet.ListedPetName
            ),

        ToolName =
            tool
            and tostring(tool.Name or "")
            or "",

        UID =
            tostring(pet.UID or ""),

        StableKey =
            tostring(pet.StableKey or ""),

        Weight =
            tonumber(pet.Weight)
            or 0,

        SavedAt =
            os.time(),
    }
end

function NormalizeShowcaseFilterIdentity(identity)

    if type(identity) ~= "table" then
        return nil
    end

    local stableKey =
        tostring(
            identity.StableKey
            or identity.UID
            or ""
        )

    if stableKey == "" then
        return nil
    end

    local petName =
        NormalizeShowcasePetName(
            identity.PetName
            or identity.ListedPetName
        )

    local listedPetName =
        NormalizeShowcasePetName(
            identity.ListedPetName
            or identity.PetName
        )

    return {
        PetName =
            petName,

        ListedPetName =
            listedPetName,

        ToolName =
            tostring(identity.ToolName or ""),

        UID =
            tostring(identity.UID or stableKey),

        StableKey =
            stableKey,

        Weight =
            tonumber(identity.Weight)
            or 0,

        SavedLabel =
            tostring(identity.SavedLabel or ""),

        SavedAt =
            tonumber(identity.SavedAt)
            or os.time(),
    }
end

function BuildShowcaseFilterFromCurrentSelection()

    local identities =
        BuildCurrentShowcaseSelectionIdentities()

    local output =
        {}

    for _, identity in ipairs(identities) do

        local normalized =
            NormalizeShowcaseFilterIdentity(identity)

        if normalized then
            table.insert(
                output,
                normalized
            )
        end
    end

    table.sort(output, function(a, b)

        local aName =
            tostring(a.PetName or ""):lower()

        local bName =
            tostring(b.PetName or ""):lower()

        if aName ~= bName then
            return aName < bName
        end

        return tostring(a.StableKey or "")
            < tostring(b.StableKey or "")
    end)

    return output
end

function ApplyShowcaseFilterToRuntime(reason)

    local savedFilter =
        BoothPetState.SavedShowcaseFilter

    if type(savedFilter) ~= "table"
    or #savedFilter <= 0 then
        return false
    end

    local selectedMap =
        {}

    local selectedLabels =
        {}

    -- Rebuild current dropdown maps first.
    BuildShowcasePetChoiceMaps()

    for _, identity in ipairs(savedFilter) do

        local normalized =
            NormalizeShowcaseFilterIdentity(identity)

        if normalized then

            local stableKey =
                tostring(normalized.StableKey or "")

            if stableKey ~= "" then

                selectedMap[stableKey] =
                    true

                local currentLabel =
                    ShowcaseStableKeyToChoice
                    and ShowcaseStableKeyToChoice[stableKey]

                local label =
                    currentLabel

                if not label
                or label == "" then

                    label =
                        FormatSavedShowcaseChoiceLabel(
                            normalized,
                            "missing"
                        )
                end

                if label
                and label ~= "" then

                    table.insert(
                        selectedLabels,
                        label
                    )

                    ShowcaseChoiceToStableKey[label] =
                        stableKey

                    ShowcaseStableKeyToChoice[stableKey] =
                        label
                end
            end
        end
    end

    table.sort(selectedLabels)

    BoothPetState.SelectedShowcasePets =
        selectedMap

    BoothPetState.SelectedShowcasePetLabels =
        selectedLabels

    BoothPetState.SavedShowcaseSelections =
        savedFilter

    BoothPetState.ShowcaseRestorePending =
        true

    print(
        "[SHOWCASE FILTER] Applied:",
        tostring(#savedFilter),
        "| reason:",
        tostring(reason or "apply")
    )

    return true
end

function SaveCurrentShowcaseFilter(reason)

    local filter =
        BuildShowcaseFilterFromCurrentSelection()

    if #filter <= 0 then

        HolyNotify(
            "No Showcase Pets Selected",
            "Select listed pets first, then press Save Selected Pets.",
            "triangle-alert",
            4
        )

        return false
    end

    BoothPetState.SavedShowcaseFilter =
        filter

    BoothPetState.SavedShowcaseSelections =
        filter

    BoothPetState.ShowcaseRestorePending =
        true

    QueueShowcaseSelectionSave(
        tostring(reason or "showcase filter saved"),
        true
    )

    HolyNotify(
        "Showcase Saved",
        tostring(#filter)
            .. " exact pet(s) saved for auto showcase after rejoin.",
        "save",
        4
    )

    print(
        "[SHOWCASE FILTER] Saved exact pets:",
        tostring(#filter)
    )

    return true
end

function FindSavedShowcaseIdentityByKey(stableKey)

    stableKey =
        tostring(stableKey or "")

    if stableKey == "" then
        return nil
    end

    for _, identity in ipairs(BoothPetState.SavedShowcaseSelections or {}) do

        local savedStableKey =
            tostring(
                identity.StableKey
                or identity.UID
                or ""
            )

        if savedStableKey == stableKey then
            return identity
        end
    end

    return nil
end

function BuildCurrentShowcaseSelectionIdentities()

    local pets =
        BuildAvailableShowcasePets()

    local byStableKey = {}

    for _, pet in ipairs(pets) do

        local stableKey =
            tostring(
                pet.StableKey
                or pet.UID
                or ""
            )

        if stableKey ~= "" then
            byStableKey[stableKey] =
                pet
        end
    end

    local output = {}
    local written = {}

    BoothPetState.SelectedShowcasePets =
        BoothPetState.SelectedShowcasePets
        or {}

    local function AddIdentityForKey(stableKey)

        stableKey =
            tostring(stableKey or "")

        if stableKey == ""
        or written[stableKey] == true then
            return
        end

        written[stableKey] =
            true

        local pet =
            byStableKey[stableKey]

        local identity =
            BuildShowcaseIdentityFromPet(pet)

        if identity then

            table.insert(
                output,
                identity
            )

            return
        end

        -- Preserve old exact identity if the pet is currently missing.
        -- Do NOT overwrite it with an empty PetName/Weight placeholder.
        local savedIdentity =
            FindSavedShowcaseIdentityByKey(stableKey)

        if savedIdentity then

            table.insert(
                output,
                savedIdentity
            )

            return
        end

        table.insert(output, {
            PetName = "",
            ListedPetName = "",
            ToolName = "",
            UID = "",
            StableKey = stableKey,
            Weight = 0,
            SavedAt = os.time(),
        })
    end

    for stableKey, selected in pairs(BoothPetState.SelectedShowcasePets) do

        if selected == true then
            AddIdentityForKey(stableKey)
        end
    end

    for _, label in ipairs(BoothPetState.SelectedShowcasePetLabels or {}) do

        local stableKey =
            ShowcaseChoiceToStableKey
            and ShowcaseChoiceToStableKey[tostring(label)]

        if stableKey then
            AddIdentityForKey(stableKey)
        end
    end

    table.sort(output, function(a, b)

        local aName =
            tostring(a.PetName or ""):lower()

        local bName =
            tostring(b.PetName or ""):lower()

        if aName ~= bName then
            return aName < bName
        end

        return tostring(a.StableKey or "")
            < tostring(b.StableKey or "")
    end)

    return output
end

function BuildShowcaseSavePayload()

    return {
        Format = "HOLY_SHOWCASE_PETS",
        Version = 1,
        SavedAt = os.time(),

        Enabled =
            BoothPetState.Enabled == true,

        RotationEnabled =
            BoothPetState.RotationEnabled == true,

        ShowcaseMode =
            NormalizeShowcaseMode(
                BoothPetState.ShowcaseMode
            ),

        AutoSwitchWhenMissing =
            BoothPetState.AutoSwitchWhenMissing == true,

        AutoSwitchMode =
            NormalizeShowcaseSwitchMode(
                BoothPetState.AutoSwitchMode
            ),

        EquipInterval =
            math.clamp(
                math.floor(
                    SafeNumber(
                        BoothPetState.EquipInterval,
                        10
                    )
                ),
                2,
                300
            ),

        SelectedPetType =
            NormalizeShowcasePetName(
                BoothPetState.SelectedPetType
            ),

        SelectedLabels =
            BoothPetState.SelectedShowcasePetLabels
            or {},

        SavedFilter =
            BoothPetState.SavedShowcaseFilter
            or {},

        Selections =
            BuildCurrentShowcaseSelectionIdentities(),
    }
end

function SaveShowcaseSelectionConfigNow(reason)

    if not CanUseShowcaseFileIO() then
        return false
    end

    EnsureShowcaseSaveFolder()

    local payload =
        BuildShowcaseSavePayload()

    local ok, encoded =
        pcall(function()
            return HttpService:JSONEncode(payload)
        end)

    if not ok
    or type(encoded) ~= "string"
    or encoded == "" then

        warn(
            "[SHOWCASE SAVE] Encode failed:",
            tostring(encoded)
        )

        return false
    end

    local writeOk, writeErr =
        pcall(function()
            writefile(
                SHOWCASE_SAVE_FILE,
                encoded
            )
        end)

    if not writeOk then

        warn(
            "[SHOWCASE SAVE] Write failed:",
            tostring(writeErr)
        )

        return false
    end

    BoothPetState.LastShowcaseSaveAt =
        os.clock()

    if ShowcaseDebugPrints == true then
        print(
            "[SHOWCASE SAVE] Saved",
            tostring(#(payload.Selections or {})),
            "selected pet(s)",
            "|",
            tostring(reason or "manual")
        )
    end

    return true
end

function QueueShowcaseSelectionSave(reason, immediate)

    if immediate == true then

        BoothPetState.ShowcaseSaveQueued =
            false

        return SaveShowcaseSelectionConfigNow(
            reason
        )
    end

    if BoothPetState.ShowcaseSaveQueued == true then
        return
    end

    BoothPetState.ShowcaseSaveQueued =
        true

    task.delay(0.35, function()

        if not IsCurrentRun() then
            return
        end

        BoothPetState.ShowcaseSaveQueued =
            false

        SaveShowcaseSelectionConfigNow(
            reason
        )
    end)
end

function LoadShowcaseSelectionConfigNow()

    if BoothPetState.ShowcaseSaveLoaded == true then
        return true
    end

    BoothPetState.ShowcaseSaveLoaded =
        true

    if not CanUseShowcaseFileIO() then
        return false
    end

    local exists =
        false

    local ok =
        pcall(function()
            exists =
                isfile(SHOWCASE_SAVE_FILE)
        end)

    if not ok
    or exists ~= true then
        return false
    end

    local readOk, raw =
        pcall(function()
            return readfile(SHOWCASE_SAVE_FILE)
        end)

    if not readOk
    or type(raw) ~= "string"
    or raw == "" then
        return false
    end

    local decodeOk, payload =
        pcall(function()
            return HttpService:JSONDecode(raw)
        end)

    if not decodeOk
    or type(payload) ~= "table"
    or payload.Format ~= "HOLY_SHOWCASE_PETS" then
        return false
    end

    BoothPetState.Enabled =
        payload.Enabled == true

    BoothPetState.RotationEnabled =
        payload.RotationEnabled == true

    BoothPetState.ShowcaseMode =
        NormalizeShowcaseMode(
            payload.ShowcaseMode
        )

    BoothPetState.AutoSwitchWhenMissing =
        payload.AutoSwitchWhenMissing ~= false

    BoothPetState.AutoSwitchMode =
        NormalizeShowcaseSwitchMode(
            payload.AutoSwitchMode
        )

    BoothPetState.EquipInterval =
        math.clamp(
            math.floor(
                SafeNumber(
                    payload.EquipInterval,
                    10
                )
            ),
            2,
            300
        )

    BoothPetState.SelectedPetType =
        NormalizeShowcasePetName(
            payload.SelectedPetType
        )

    BoothPetState.SavedShowcaseFilter =
        type(payload.SavedFilter) == "table"
        and payload.SavedFilter
        or {}

    BoothPetState.SavedShowcaseSelections =
        #BoothPetState.SavedShowcaseFilter > 0
        and BoothPetState.SavedShowcaseFilter
        or (
            type(payload.Selections) == "table"
            and payload.Selections
            or {}
        )

    BoothPetState.SelectedShowcasePetLabels =
        type(payload.SelectedLabels) == "table"
        and payload.SelectedLabels
        or BuildSavedShowcaseChoiceLabels("missing")

    BoothPetState.ShowcaseRestorePending =
        #(BoothPetState.SavedShowcaseFilter or {}) > 0
        or #(BoothPetState.SavedShowcaseSelections or {}) > 0
        or #(BoothPetState.SelectedShowcasePetLabels or {}) > 0

    ApplyShowcaseFilterToRuntime(
        "load config"
    )

    print(
        "[SHOWCASE SAVE] Loaded",
        tostring(#(BoothPetState.SavedShowcaseSelections or {})),
        "saved pet selection(s)",
        "| labels:",
        tostring(#(BoothPetState.SelectedShowcasePetLabels or {})),
        "| restore:",
        tostring(BoothPetState.ShowcaseRestorePending)
    )

    return true
end

function ShowcaseSavedIdentityMatchesPet(identity, pet)

    if type(identity) ~= "table"
    or type(pet) ~= "table" then
        return false
    end

    local savedStableKey =
        tostring(identity.StableKey or "")

    local currentStableKey =
        tostring(pet.StableKey or "")

    if savedStableKey ~= ""
    and currentStableKey ~= ""
    and savedStableKey == currentStableKey then
        return true
    end

    local savedUID =
        tostring(identity.UID or "")

    local currentUID =
        tostring(pet.UID or "")

    if savedUID ~= ""
    and currentUID ~= ""
    and savedUID == currentUID then
        return true
    end

    local savedToolName =
        tostring(identity.ToolName or "")

    local currentToolName =
        pet.Tool
        and tostring(pet.Tool.Name or "")
        or ""

    if savedToolName ~= ""
    and currentToolName ~= ""
    and savedToolName == currentToolName then
        return true
    end

    -- No pet-name fallback.
    -- If exact identity is gone, keep it as missing instead of using another duplicate.
    return false
end

function RestoreShowcaseSelectionsFromSaved()

    local savedSelections =
        BoothPetState.SavedShowcaseSelections

    if type(savedSelections) ~= "table"
    or #savedSelections <= 0 then

        BoothPetState.SelectedShowcasePetLabels =
            BuildSavedShowcaseChoiceLabels("missing")

        return false
    end

    BuildShowcasePetChoiceMaps()

    local pets =
        BuildAvailableShowcasePets()

    if #pets <= 0 then

        BoothPetState.SelectedShowcasePetLabels =
            BuildSavedShowcaseChoiceLabels("missing")

        BoothPetState.ShowcaseRestorePending =
            true

        return false
    end

    local selectedMap = {}
    local labels = {}
    local restored = 0
    local missing = 0

    for _, identity in ipairs(savedSelections) do

        local found =
            false

        for _, pet in ipairs(pets) do

            local stableKey =
                tostring(
                    pet.StableKey
                    or pet.UID
                    or ""
                )

            if stableKey ~= ""
            and not selectedMap[stableKey]
            and ShowcaseSavedIdentityMatchesPet(identity, pet) then

                selectedMap[stableKey] =
                    true

                local label =
                    ShowcaseStableKeyToChoice
                    and ShowcaseStableKeyToChoice[stableKey]

                if label then
                    table.insert(
                        labels,
                        label
                    )
                end

                restored =
                    restored + 1

                found =
                    true

                break
            end
        end

        if found ~= true then

            missing =
                missing + 1

            local stableKey =
                tostring(
                    identity.StableKey
                    or identity.UID
                    or ""
                )

            if stableKey ~= "" then

                selectedMap[stableKey] =
                    true

                local missingLabel =
                    FormatSavedShowcaseChoiceLabel(
                        identity,
                        "missing"
                    )

                if missingLabel
                and missingLabel ~= "" then

                    table.insert(
                        labels,
                        missingLabel
                    )

                    ShowcaseChoiceToStableKey[missingLabel] =
                        stableKey

                    ShowcaseStableKeyToChoice[stableKey] =
                        missingLabel
                end
            end
        end
    end

    table.sort(labels)

    BoothPetState.SelectedShowcasePets =
        selectedMap

    BoothPetState.SelectedShowcasePetLabels =
        labels

    BoothPetState.ShowcaseRestorePending =
        missing > 0

    local candidate =
        ChooseShowcaseCandidate(
            pets,
            "Selected Listed Rotation",
            nil
        )

    if candidate
    and candidate.PetName then

        SetShowcasePetSelection(
            candidate
        )
    end

    print(
        "[SHOWCASE SAVE] Restored:",
        tostring(restored),
        "| missing:",
        tostring(missing)
    )

    return restored > 0
end

function SyncShowcaseSelectedLabelsFromKeys()

    local labels = {}

    BoothPetState.SelectedShowcasePets =
        BoothPetState.SelectedShowcasePets
        or {}

    for stableKey, selected in pairs(BoothPetState.SelectedShowcasePets) do

        if selected == true then

            local label =
                ShowcaseStableKeyToChoice
                and ShowcaseStableKeyToChoice[stableKey]

            if label then
                table.insert(
                    labels,
                    label
                )
            end
        end
    end

    table.sort(labels)

    BoothPetState.SelectedShowcasePetLabels =
        labels

    return labels
end

function ResolveShowcaseSelectedMapFromDropdown(value)

    local output = {}
    local labels = {}

    if type(value) == "table" then

        for label, selected in pairs(value) do

            if selected == true then

                local stableKey =
                    ShowcaseChoiceToStableKey
                    and ShowcaseChoiceToStableKey[tostring(label)]

                if stableKey then

                    output[stableKey] =
                        true

                    table.insert(
                        labels,
                        tostring(label)
                    )
                end
            end
        end

    elseif type(value) == "string" then

        local stableKey =
            ShowcaseChoiceToStableKey
            and ShowcaseChoiceToStableKey[value]

        if stableKey then

            output[stableKey] =
                true

            table.insert(
                labels,
                value
            )
        end
    end

    table.sort(labels)

    return output, labels
end

function RefreshShowcasePetDropdown(clearSelection)

    local choices =
        BuildShowcasePetChoiceMaps()

    if clearSelection ~= true
    and type(BoothPetState.SavedShowcaseFilter) == "table"
    and #BoothPetState.SavedShowcaseFilter > 0 then

        ApplyShowcaseFilterToRuntime(
            "dropdown refresh"
        )
    end

    if clearSelection == true then

        BoothPetState.SelectedShowcasePets =
            {}

        BoothPetState.SelectedShowcasePetLabels =
            {}

        BoothPetState.SavedShowcaseSelections =
            {}

        BoothPetState.ShowcaseRestorePending =
            false

        BoothPetState.SelectedPetType =
            nil

        BoothPetState.LastEquippedUID =
            nil

        BoothPetState.LockedShowcaseUID =
            nil

        if ShowcaseDropdownRef
        and type(ShowcaseDropdownRef.SetValues) == "function" then

            ShowcaseDropdownRef:SetValues(
                choices
            )
        end

        if ShowcaseDropdownRef
        and type(ShowcaseDropdownRef.SetValue) == "function" then

            ShowcaseDropdownSyncing =
                true

            ShowcaseDropdownRef:SetValue({})

            ShowcaseDropdownSyncing =
                false
        end

        QueueShowcaseSelectionSave(
            "clear showcase selection",
            true
        )

        return choices
    end

    local hadRestoreData =
        BoothPetState.ShowcaseRestorePending == true
        or #(BoothPetState.SavedShowcaseSelections or {}) > 0
        or #(BoothPetState.SelectedShowcasePetLabels or {}) > 0

    local restored =
        false

    if BoothPetState.ShowcaseRestorePending == true
    or #(BoothPetState.SavedShowcaseSelections or {}) > 0 then

        restored =
            RestoreShowcaseSelectionsFromSaved()
    end

    if restored == true then

        -- Real listed pets were found.
        -- Labels now point to real current dropdown rows.
        SyncShowcaseSelectedLabelsFromKeys()

    elseif hadRestoreData == true then

        -- Real listed pets are not ready yet.
        -- Keep exact saved rows visible as missing placeholders.
        -- Must match MergeSavedShowcaseLabelsIntoChoices().
        BoothPetState.SelectedShowcasePetLabels =
            BuildSavedShowcaseChoiceLabels("missing")

    else

        -- Normal refresh with no pending save data.
        SyncShowcaseSelectedLabelsFromKeys()
    end

    -- Critical:
    -- if real listed choices are not ready yet, keep saved labels visible.
    choices =
        MergeSavedShowcaseLabelsIntoChoices(
            choices
        )

    if ShowcaseDropdownRef
    and type(ShowcaseDropdownRef.SetValues) == "function" then

        ShowcaseDropdownRef:SetValues(
            choices
        )
    end

    if ShowcaseDropdownRef
    and type(ShowcaseDropdownRef.SetValue) == "function" then

        ShowcaseDropdownSyncing =
            true

        local selectedValueMap =
            {}

        for _, label in ipairs(BoothPetState.SelectedShowcasePetLabels or {}) do

            label =
                tostring(label or "")

            if label ~= "" then
                selectedValueMap[label] =
                    true
            end
        end

        ShowcaseDropdownRef:SetValue(
            selectedValueMap
        )

        ShowcaseDropdownSyncing =
            false
    end

    return choices
end

function RequestShowcaseRestoreRefresh(reason, delayTime)

    if BoothPetState.ShowcaseRestoreWorkerStarted == true then
        return
    end

    BoothPetState.ShowcaseRestoreWorkerStarted =
        true

    task.spawn(function()

        delayTime =
            SafeNumber(delayTime, 0.75)

        task.wait(delayTime)

        for attempt = 1, 20 do

            if not IsCurrentRun() then
                return
            end

            if type(RefreshLatestBoothDataNow) == "function" then
                pcall(function()
                    RefreshLatestBoothDataNow(
                        tostring(reason or "showcase restore")
                    )
                end)
            end

            if type(RefreshOwnBoothSnapshot) == "function" then
                pcall(function()
                    RefreshOwnBoothSnapshot()
                end)
            end

            local choices =
                RefreshShowcasePetDropdown(false)

            ApplyShowcaseFilterToRuntime(
                "restore worker"
            )

            local available =
                0

            for _, pet in ipairs(
                BuildSelectedShowcaseCandidateList(
                    BuildAvailableShowcasePets(),
                    true
                )
            ) do
                available =
                    available + 1
            end

            if available > 0 then

                print(
                    "[SHOWCASE SAVE] Auto restore ready | available:",
                    tostring(available),
                    "| choices:",
                    tostring(#choices)
                )

                if BoothPetState.Enabled == true then
                    EquipShowcasePet(true)
                end

                BoothPetState.ShowcaseRestoreWorkerStarted =
                    false

                return
            end

            task.wait(1.0)
        end

        BoothPetState.ShowcaseRestoreWorkerStarted =
            false

        warn(
            "[SHOWCASE SAVE] Auto restore ended; exact saved pets still missing."
        )
    end)
end

function BuildSelectedShowcaseCandidateList(pets, requireSelected)

    local output = {}

    pets =
        pets
        or BuildAvailableShowcasePets()

    BoothPetState.SelectedShowcasePets =
        BoothPetState.SelectedShowcasePets
        or {}

    requireSelected =
        requireSelected == true

    for _, pet in ipairs(pets) do

        if type(pet) ~= "table" then
            continue
        end

        local stableKey =
            tostring(
                pet.StableKey
                or pet.UID
                or ""
            )

        if stableKey == "" then
            continue
        end

        -- Critical:
        -- Dropdown may show Backpack pets, but showcase runtime
        -- must only equip pets confirmed listed in your booth.
        if pet.IsListed ~= true then
            continue
        end

        if requireSelected == true then

            if BoothPetState.SelectedShowcasePets[stableKey] == true then
                table.insert(
                    output,
                    pet
                )
            end

        else

            -- Highest Weight Listed Pet / Random Listed Pet
            -- should use all listed pets, not unlisted backpack pets.
            table.insert(
                output,
                pet
            )
        end
    end

    return SortShowcasePetsForUI(output)
end

function ChooseShowcaseCandidate(pets, mode, missingPetName)

    pets =
        pets
        or BuildAvailableShowcasePets()

    missingPetName =
        NormalizeShowcasePetName(missingPetName)

    local candidates =
        BuildSelectedShowcaseCandidateList(
            pets,
            true
        )

    if #candidates <= 0 then
        return nil
    end

    if missingPetName ~= "" then

        local filtered =
            {}

        for _, pet in ipairs(candidates) do

            local petName =
                NormalizeShowcasePetName(
                    pet.PetName
                )

            if petName:lower() ~= missingPetName:lower() then
                table.insert(
                    filtered,
                    pet
                )
            end
        end

        candidates =
            filtered
    end

    if #candidates <= 0 then
        return nil
    end

    BoothPetState.RotationIndex =
        math.max(
            1,
            math.floor(
                SafeNumber(
                    BoothPetState.RotationIndex,
                    1
                )
            )
        )

    if BoothPetState.RotationIndex > #candidates then
        BoothPetState.RotationIndex =
            1
    end

    local selected =
        candidates[
            BoothPetState.RotationIndex
        ]

    BoothPetState.RotationIndex =
        BoothPetState.RotationIndex + 1

    if BoothPetState.RotationIndex > #candidates then
        BoothPetState.RotationIndex =
            1
    end

    return selected
end

function ResolveFallbackShowcasePet(missingPetName)

    if type(RefreshLatestBoothDataNow) == "function" then
        pcall(function()
            RefreshLatestBoothDataNow(
                "showcase fallback resolve"
            )
        end)
    end

    if type(RefreshOwnBoothSnapshot) == "function" then
        pcall(function()
            RefreshOwnBoothSnapshot()
        end)
    end

    local pets =
        BuildAvailableShowcasePets()

    if #pets <= 0 then
        return nil
    end

    return ChooseShowcaseCandidate(
        pets,
        "Next Selected Listed Pet",
        missingPetName
    )
end

function SetShowcasePetSelection(petOrName)

    local petName =
        nil

    local stableKey =
        ""

    local uid =
        ""

    if type(petOrName) == "table" then

        petName =
            NormalizeShowcasePetName(
                petOrName.PetName
            )

        stableKey =
            tostring(
                petOrName.StableKey
                or ""
            )

        uid =
            tostring(
                petOrName.UID
                or ""
            )

    else

        petName =
            NormalizeShowcasePetName(
                petOrName
            )
    end

    if petName == "" then
        return false
    end

    BoothPetState.SelectedPetType =
        petName

    BoothPetState.SelectedShowcaseStableKey =
        stableKey

    BoothPetState.SelectedShowcaseUID =
        uid

    BoothPetState.LastEquippedUID =
        nil

    -- Important:
    -- If we know the exact UID, lock to it.
    -- This prevents duplicate pet names from selecting highest KG.
    BoothPetState.LockedShowcaseUID =
        uid ~= ""
        and uid
        or nil

    BoothPetState.LastMissingPet =
        nil

    BoothPetState.LastMissingWarnAt =
        0

    return true
end

function TryAutoSwitchShowcasePet(missingPetName)

    if BoothPetState.AutoSwitchWhenMissing ~= true then
        return false
    end

    local now =
        os.clock()

    if now - SafeNumber(BoothPetState.LastAutoSwitchAt, 0)
        < SafeNumber(BoothPetState.AutoSwitchCooldown, 8)
    then
        return false
    end

    local missingClean =
        NormalizeShowcasePetName(
            missingPetName
        )

    if BoothPetState.LastAutoSwitchFailedPet == missingClean
    and now - SafeNumber(BoothPetState.LastAutoSwitchFailedAt, 0)
        < SafeNumber(BoothPetState.AutoSwitchFailCooldown, 20)
    then
        return false
    end

    BoothPetState.LastAutoSwitchAt =
        now

    -- Refresh booth data once before choosing fallback.
    -- This helps right after a sale, where LatestBoothData may be stale.
    if type(RefreshLatestBoothDataNow) == "function" then
        pcall(function()
            RefreshLatestBoothDataNow(
                "showcase auto switch"
            )
        end)
    end

    if type(RefreshOwnBoothSnapshot) == "function" then
        pcall(function()
            RefreshOwnBoothSnapshot()
        end)
    end

    local fallback =
        ResolveFallbackShowcasePet(
            missingClean
        )

    if not fallback
    or not fallback.PetName
    or fallback.PetName == "" then

        BoothPetState.LastAutoSwitchFailedAt =
            now

        BoothPetState.LastAutoSwitchFailedPet =
            missingClean

        warn(
            "[BoothPet] Auto switch failed; no listed booth pet available:",
            tostring(missingClean)
        )

        return false
    end

    local oldPet =
        tostring(missingClean or "Unknown")

    local newPet =
        NormalizeShowcasePetName(
            fallback.PetName
        )

    if newPet == ""
    or newPet:lower() == oldPet:lower() then

        BoothPetState.LastAutoSwitchFailedAt =
            now

        BoothPetState.LastAutoSwitchFailedPet =
            missingClean

        return false
    end

    BoothPetState.LastEquippedUID =
        nil

    BoothPetState.LockedShowcaseUID =
        nil

    BoothPetState.LastMissingPet =
        nil

    BoothPetState.LastMissingWarnAt =
        0

    SetShowcasePetSelection(
        fallback
    )

    task.spawn(function()

        task.wait(0.20)

        if BoothPetState.Enabled ~= true then
            return
        end

        if NormalizeShowcasePetName(BoothPetState.SelectedPetType) ~= newPet then
            return
        end

        if type(EquipShowcasePet) == "function" then

            for attempt = 1, 4 do

                if BoothPetState.Enabled ~= true then
                    return
                end

                if NormalizeShowcasePetName(BoothPetState.SelectedPetType) ~= newPet then
                    return
                end

                EquipShowcasePet(true)

                task.wait(0.25)
            end
        end
    end)

    print(
        "[BoothPet] Auto switched showcase:",
        tostring(oldPet),
        "→",
        tostring(newPet),
        "| listed as:",
        tostring(fallback.ListedPetName or newPet)
    )

    HolyNotify(
        "Showcase Switched",
        tostring(oldPet)
            .. " missing. Now showcasing listed pet "
            .. tostring(newPet)
            .. ".",
        "refresh-cw",
        4
    )

    return true
end
