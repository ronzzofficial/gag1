function GetPetRegistry()

    if type(PetRegistry) == "table" then
        return PetRegistry
    end

    local ok, result =
        pcall(function()
            return require(
                ReplicatedStorage
                    :WaitForChild("Data")
                    :WaitForChild("PetRegistry")
            )
        end)

    if ok
    and type(result) == "table" then
        PetRegistry = result
        return PetRegistry
    end

    return nil
end

