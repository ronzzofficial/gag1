RequestFunction =
    syn and syn.request
    or http_request
    or request
    or (http and http.request)
    or (fluxus and fluxus.request)
print("[WEBHOOK] RequestFunction:", RequestFunction)

function NormalizeWebhookURL(url)

    return tostring(url or "")
        :gsub("%s+", "")
end

function NormalizeWebhookRoute(route)

    route =
        tostring(route or "Main")

    if route == "Secondary"
    or route == "Second"
    or route == "Webhook 2"
    or route == "2" then
        return "Secondary"
    end

    return "Main"
end

function ResolveWebhookRouteURL(route)

    route =
        NormalizeWebhookRoute(route)

    local mainURL =
        NormalizeWebhookURL(
            WebhookState
            and WebhookState.URL
        )

    if route == "Secondary" then

        local secondaryURL =
            NormalizeWebhookURL(
                WebhookState
                and WebhookState.SecondaryURL
            )

        if secondaryURL ~= "" then
            return secondaryURL, "Secondary"
        end

        -- Fallback keeps events from silently failing if URL 2 is empty.
        return mainURL, "Main"
    end

    if mainURL ~= "" then
        return mainURL, "Main"
    end

    local secondaryURL =
        NormalizeWebhookURL(
            WebhookState
            and WebhookState.SecondaryURL
        )

    -- Booth-sale and other personal notifications should still work when
    -- the user has configured only the secondary webhook URL.
    if secondaryURL ~= "" then
        return secondaryURL, "Secondary"
    end

    return "", "Main"
end

function CanSendWebhookToURL(url)

    if not WebhookState.Enabled then
        warn("[Webhook] Disabled")
        return false
    end

    url =
        NormalizeWebhookURL(url)

    if url == "" then
        warn("[Webhook] Missing URL")
        return false
    end

    if not RequestFunction then
        warn("[Webhook] No request function available")
        return false
    end

    return true
end

function CanSendWebhook()

    local url =
        ResolveWebhookRouteURL("Main")

    return CanSendWebhookToURL(url)
end

