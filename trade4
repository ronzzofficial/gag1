function TryAcceptHolyFriendNotification(instance)

    if not UIState
    or UIState.AutoAcceptFriendRequests ~= true then
        return false
    end

    local root =
        FindHolyFriendNotificationRoot(instance)

    if not root then
        return false
    end

    local notificationText =
        root:FindFirstChild("NotificationText", true)

    local acceptButton =
        root:FindFirstChild("Button1", true)

    local text =
        ReadHolyGuiText(notificationText)

    if text == "" then

        for _, descendant in ipairs(root:GetDescendants()) do

            local candidate =
                ReadHolyGuiText(descendant)

            local lowerCandidate =
                candidate:lower()

            if lowerCandidate:find("friend request", 1, true)
            or (
                lowerCandidate:find("sent you", 1, true)
                and lowerCandidate:find("friend", 1, true)
            ) then
                text = candidate
                break
            end
        end
    end

    if not acceptButton
    or not acceptButton:IsA("GuiButton") then

        for _, descendant in ipairs(root:GetDescendants()) do

            if descendant:IsA("GuiButton") then

                local buttonText =
                    ReadHolyGuiText(descendant):lower()

                local buttonName =
                    tostring(descendant.Name or ""):lower()

                if buttonText == "accept"
                or buttonName == "accept"
                or buttonName:find("accept", 1, true) then
                    acceptButton = descendant
                    break
                end
            end
        end
    end

    local lowerText =
        tostring(text or ""):lower()

    if not lowerText:find("friend request", 1, true)
    and not (
        lowerText:find("sent you", 1, true)
        and lowerText:find("friend", 1, true)
    ) then
        return false
    end

    if not acceptButton then
        return false
    end

    local now =
        os.clock()

    if AutoFriendState.LastNotificationRoot == root
    and now - SafeNumber(AutoFriendState.LastAcceptedAt, 0) < 2 then
        return false
    end

    local clicked =
        ClickHolyGuiButton(
            acceptButton
        )

    if clicked then

        AutoFriendState.LastNotificationRoot =
            root

        AutoFriendState.LastAcceptedAt =
            now

        AutoFriendState.AcceptedThisSession =
            SafeNumber(
                AutoFriendState.AcceptedThisSession,
                0
            ) + 1

        AutoFriendState.LastAcceptedName =
            "Friend Request"

        AutoFriendState.LastError =
            "None"

        print("[HOLY FRIENDS] Auto accepted friend request.")

        if type(RefreshAutoFriendHomeLabel) == "function" then
            RefreshAutoFriendHomeLabel()
        end

        return true
    end

    AutoFriendState.LastError =
        "Accept click failed"

    warn("[HOLY FRIENDS] Failed to click Accept button.")

    return false
end

function StartAutoFriendRequestWatcher()

    if AutoFriendState.WatcherStarted == true then
        return false
    end

    AutoFriendState.WatcherStarted =
        true

    local watchRoot =
        CoreGui

    watchRoot.DescendantAdded:Connect(function(instance)

        task.defer(function()

            TryAcceptHolyFriendNotification(
                instance
            )

            task.wait(0.10)

            TryAcceptHolyFriendNotification(
                instance
            )
        end)
    end)

    -- Catch an already visible request if it appeared before the watcher started.
    task.defer(function()

        for _, descendant in ipairs(CoreGui:GetDescendants()) do

            if TryAcceptHolyFriendNotification(descendant) then
                break
            end
        end
    end)

    print("[HOLY FRIENDS] Auto friend request watcher loaded.")

    return true
end

