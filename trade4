function IsHolyPurchaseLaneBusy()

    if type(PurchaseState) == "table"
    and PurchaseState.Busy == true then
        return true
    end

    if type(PurchaseQueue) == "table"
    and #PurchaseQueue > 0 then
        return true
    end

    if type(ActivePurchases) == "table" then

        for _ in pairs(ActivePurchases) do
            return true
