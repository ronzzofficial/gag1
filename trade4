TokenBalanceCache = {
    Value = 0,
    LastUpdatedAt = 0,
}

function ParseHolyTokenNumber(value)

    local text =
        tostring(value or "")
            :gsub(",", "")
            :gsub("%s+", "")

    local numberText, suffix =
        text:match("([%d]+%.?[%d]*)([KkMmBbTt]?)")

    local number =
        tonumber(numberText)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000,
    }

    local multiplier =
        multipliers[tostring(suffix or ""):upper()]
        or 1

    return math.floor(number * multiplier + 0.5)
end

function GetTokenBalance()

    local player =
        Players.LocalPlayer

    local playerGui =
        player
        and player:FindFirstChild("PlayerGui")

    local bestNumber =
        0

    local function Consider(value)

        local number =
            ParseHolyTokenNumber(value)

        if number
        and number > bestNumber then
            bestNumber = number
        end
    end

    local function ScanTokenRoot(root)

        if not root then
            return
        end

        if root:IsA("TextLabel")
        or root:IsA("TextButton")
        or root:IsA("TextBox") then
            Consider(root.Text)
        elseif root:IsA("IntValue")
        or root:IsA("NumberValue") then
            Consider(root.Value)
        end

        for _, object in ipairs(root:GetDescendants()) do

            if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then
                Consider(object.Text)
            elseif object:IsA("IntValue")
            or object:IsA("NumberValue") then
                Consider(object.Value)
            end
        end
    end

    if playerGui then

        local tokenUI =
            playerGui:FindFirstChild(
                "TradeTokenCurrency_UI",
                true
            )

        local tradeTokens =
            playerGui:FindFirstChild(
                "TradeTokens",
                true
            )

        ScanTokenRoot(tokenUI)
        ScanTokenRoot(tradeTokens)

        -- UI names change between game updates. Scan currency/token
        -- containers as a fallback without reading unrelated booth prices.
        if bestNumber <= 0 then

            for _, object in ipairs(playerGui:GetDescendants()) do

                local name =
                    tostring(object.Name or ""):lower()

                if name:find("token", 1, true)
                and (
                    name:find("trade", 1, true)
                    or name:find("currency", 1, true)
                ) then
                    ScanTokenRoot(object)
                end
            end
        end
    end

    if player then

        -- Some clients expose the live balance through a replicated value
        -- instead of the currency UI.
        for _, object in ipairs(player:GetDescendants()) do

            local name =
                tostring(object.Name or ""):lower()

            if name:find("token", 1, true)
            and (
                object:IsA("IntValue")
                or object:IsA("NumberValue")
            ) then
                Consider(object.Value)
            end
        end
    end

    if bestNumber > 0 then

        TokenBalanceCache.Value =
            bestNumber

        TokenBalanceCache.LastUpdatedAt =
            os.clock()

        return bestNumber
    end

    return SafeNumber(
        TokenBalanceCache
        and TokenBalanceCache.Value,
        0
    )
end


