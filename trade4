function GetBoothDataRefreshInterval()

    local interval =
        tonumber(
            SniperState
            and SniperState.BoothDataRefreshInterval
        )

    if not interval then
        interval =
            ResolveBoothDataRefreshInterval(
                SniperState
                and SniperState.BoothDataRefreshMode
                or "Fast"
            )
    end

    return math.clamp(
        interval,
        0.01,
        0.20
    )
end

