        if number % 1 == 0 then
            return tostring(number)
        end

        return string.format("%.2f", number)
            :gsub("0+$", "")
            :gsub("%.$", "")
    end

    local function FormatCompactTokens(value)

        local number =
            tonumber(value)
            or 0

        number =
            math.floor(number)

        if number >= 1000000 then

            return string.format(
                "%.1fm",
                number / 1000000
            ):gsub("%.0m", "m")
        end

        if number >= 1000 then

            return string.format(
                "%.1fk",
