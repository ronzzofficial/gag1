function ResolveBoothNetTokens(grossPrice)

    local price =
        tonumber(grossPrice)

    if not price
    or price <= 0 then
        return 0
    end

    if type(TradeBoothsData) == "table"
    and type(TradeBoothsData.applyFee) == "function" then

        local ok, result =
            pcall(function()
                return TradeBoothsData.applyFee(price)
            end)

        if ok
        and tonumber(result) then
            return math.max(
                1,
                math.floor(tonumber(result))
            )
        end
    end

    -- Fallback confirmed from your test:
    -- 1000 -> 990, so booth fee is 1%.
    return math.max(
        1,
        math.floor(price * 0.99)
    )
end

function ResolveOwnBoothPlayerData(data, boothData, localUserId)

    if type(data) ~= "table"
    or type(data.Players) ~= "table"
    or type(boothData) ~= "table" then
        return nil
    end

    localUserId =
        tonumber(localUserId)

    if not localUserId then
        return nil
    end

    local owner =
        boothData.Owner
        or boothData.UserId
        or boothData.Player
        or boothData.PlayerId

    local function ResolveUserId(value)

        if type(value) == "number" then
            return math.floor(value)
        end

        if type(value) == "table" then
            return ResolveUserId(
                value.UserId
                or value.UserID
                or value.PlayerId
                or value.Id
            )
        end

        local ok, instanceUserId =
            pcall(function()
                return value.UserId
            end)

        if ok
        and tonumber(instanceUserId) then
            return math.floor(tonumber(instanceUserId))
        end

        local text =
            tostring(value or "")

        return tonumber(text)
            or tonumber(text:match("_(%d+)$"))
    end

    local function MatchesLocalUserId(value)

        if ResolveUserId(value) == localUserId then
            return true
        end

        if type(value) == "table" then
            return false
        end

        for userIdText in tostring(value or ""):gmatch("%d+") do

            if tonumber(userIdText) == localUserId then
                return true
            end
        end

        return false
    end

    if not MatchesLocalUserId(owner) then
        return nil
    end

    if type(data.Players[owner]) == "table" then
        return data.Players[owner]
    end

    local ownerText =
        tostring(owner or "")

    if type(data.Players[ownerText]) == "table" then
        return data.Players[ownerText]
    end

    for playerKey, playerData in pairs(data.Players) do

        if type(playerData) == "table"
        and MatchesLocalUserId(playerKey) then
            return playerData
        end
    end

    return nil
end

function BuildOwnListingSnapshot()

    local snapshot = {}

    local data = LatestBoothData

    if not data
    or not data.Booths
    or not data.Players then
        return snapshot
    end

    local localUserId =
        Players.LocalPlayer.UserId

    for boothId, boothData in pairs(data.Booths) do

        if type(boothData) ~= "table" then
            continue
        end

        local playerData =
            ResolveOwnBoothPlayerData(
                data,
                boothData,
                localUserId
            )

        if type(playerData) ~= "table" then
            continue
        end

        local listings =
            playerData.Listings

        local items =
            playerData.Items

        if type(listings) ~= "table"
        or type(items) ~= "table" then
            continue
        end

        for uid, listingData in pairs(listings) do

            if type(listingData) ~= "table" then
                continue
            end

            local item =
                items[listingData.ItemId]
                or items[tostring(listingData.ItemId)]

            if not item then

                for itemId, candidate in pairs(items) do

                    if tostring(itemId) == tostring(listingData.ItemId) then
                        item = candidate
                        break
                    end
                end
            end

            if type(item) ~= "table" then
                continue
            end

            local petData =
                item.PetData
                or item.Pet
                or item.Data
                or listingData.PetData
                or {}

local itemUUID =
    tostring(
        listingData.ItemId
        or uid
        or ""
    )

local rawPetName =
    tostring(
        item.PetType
        or item.PetName
        or listingData.PetType
        or listingData.PetName
        or "Unknown"
    )

local listedMetadata =
    ResolveOwnListedMetadata(
