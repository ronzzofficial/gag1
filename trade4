--==================================================
-- MAIN UI LAUNCHER
-- Always-visible, draggable Holy button. It is intentionally separate
-- from the library window so it remains available after the UI is hidden.
--==================================================

function CreateHolyMainLauncher()

    pcall(function()
        -- Keep Roblox's cursor above the floating launcher while hovering
        -- or dragging it.
        UserInputService.MouseIconEnabled = true
    end)

    local parent =
        nil

    if type(gethui) == "function" then

        pcall(function()
            parent = gethui()
        end)
    end

    if not parent then

        local player =
            Players.LocalPlayer

        parent =
            player
            and player:FindFirstChild("PlayerGui")
            or CoreGui
    end

    if not parent then
        return nil
    end

    local oldLauncher =
        parent:FindFirstChild("HolyMainLauncher")

    if oldLauncher then
        oldLauncher:Destroy()
    end

    local screenGui =
        Instance.new("ScreenGui")

    screenGui.Name =
        "HolyMainLauncher"

    screenGui.ResetOnSpawn =
        false

    screenGui.IgnoreGuiInset =
        true

    screenGui.DisplayOrder =
        10000

    screenGui.ZIndexBehavior =
        Enum.ZIndexBehavior.Sibling

    screenGui.Parent =
        parent

    local button =
        Instance.new("TextButton")

    button.Name =
        "HolyLogoButton"

    button.Size =
        UDim2.fromOffset(58, 58)

    button.Position =
        UDim2.new(0, 18, 0.5, -29)

    button.BackgroundColor3 =
        Color3.fromRGB(72, 34, 128)

    button.BorderSizePixel =
        0

    button.Text =
        "H"

    button.TextColor3 =
        Color3.fromRGB(255, 239, 186)

    button.TextStrokeColor3 =
        Color3.fromRGB(20, 9, 42)

    button.TextStrokeTransparency =
        0

    button.TextSize =
        28

    button.Font =
        Enum.Font.GothamBlack

    button.AutoButtonColor =
        true

    button.Active =
        true

    button.ZIndex =
        10001

    button.Parent =
        screenGui

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(1, 0)

    corner.Parent =
        button

    local stroke =
        Instance.new("UIStroke")

    stroke.Color =
        Color3.fromRGB(255, 205, 105)

    stroke.Thickness =
        2

    stroke.Transparency =
        0.15

    stroke.Parent =
        button

    local gradient =
        Instance.new("UIGradient")

    gradient.Color =
        ColorSequence.new({
            ColorSequenceKeypoint.new(
                0,
                Color3.fromRGB(150, 82, 255)
            ),
            ColorSequenceKeypoint.new(
                1,
                Color3.fromRGB(45, 18, 90)
            ),
        })

    gradient.Rotation =
        45

    gradient.Parent =
        button

    local dragging =
        false

    local dragged =
        false

    local dragStart =
        nil

    local startPosition =
        nil

    button.InputBegan:Connect(function(input)

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        dragging =
            true

        dragged =
            false

        dragStart =
            input.Position

        startPosition =
            button.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)

        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta =
            input.Position - dragStart

        if delta.Magnitude > 3 then
            dragged = true
        end

        button.Position =
            UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
    end)

    button.MouseButton1Click:Connect(function()

        if dragged then
            return
        end

        local toggled =
            false

        if Library
        and type(Library.Toggle) == "function" then

            local ok =
                pcall(function()
                    Library:Toggle()
                end)

            toggled =
                ok
        end

        if not toggled
        and Window
        and type(Window.Toggle) == "function" then

            local ok =
                pcall(function()
                    Window:Toggle()
                end)

            toggled =
                ok
        end

        if not toggled then
            warn("[HOLY LAUNCHER] Unable to toggle the main UI.")
        end
    end)

    return screenGui
end

