    end

    return false
end

function CanBoothRepositionNow()

    if game.PlaceId ~= TRADING_WORLD_PLACE_ID then
        return false, "Not Trade World"
    end

    if type(IsHolyPurchaseLaneBusy) == "function"
    and IsHolyPurchaseLaneBusy() == true then
        return false, "Purchase lane busy"
    end

