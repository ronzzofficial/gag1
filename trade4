function IsGrowGardenNormalWorld()

    return game.PlaceId == GROW_A_GARDEN_PLACE_ID
end

function CanAgeBreakerAutoAct(cooldown)

    cooldown =
        SafeNumber(
            cooldown,
            1
        )

    if AgeBreakerState.Enabled ~= true then
        return false, "Disabled"
    end

    if AgeBreakerState.AutoBusy == true then
        return false, "Busy"
    end

    if SafeElapsed(AgeBreakerState.LastAutoActionAt) < cooldown then
        return false, "Cooldown"
    end

    return true, "OK"
end

function BuildAgeBreakerMachineStartTeleportKey()

    local uuid =
        AgeBreakerNormalizeUUID(
            AgeBreakerState.MachineTargetUUID
            or AgeBreakerState.LoadedTargetUUID
            or (
                AgeBreakerState.MachineTargetSnapshot
                and AgeBreakerState.MachineTargetSnapshot.UUID
            )
            or (
                AgeBreakerState.TargetPet
                and AgeBreakerState.TargetPet.UUID
            )
            or ""
        )

    if uuid ~= "" then
        return uuid
    end

    -- Fallback key for cases where the game timer exists but UUID was not recoverable.
    return "timer:"
        .. tostring(
            math.floor(
                SafeNumber(
                    AgeBreakerState.TimerSeconds,
                    0
                )
            )
        )
end

function RequestAgeBreakerTradeWorldTeleportAfterMachineStart(reason)

    if AgeBreakerState.AutoTeleportToTradeWorldOnMachineStart ~= true then
        return false, "Auto Trade World teleport disabled"
    end

    if IsTradeWorld() then
        return false, "Already in Trade World"
    end

    if not IsGrowGardenNormalWorld() then
        return false, "Not in Normal World"
    end

    -- Critical safety:
    -- Do not leave Normal World while the target is uploaded but sacrifice has not completed.
    if AgeBreakerState.TargetLoadedWaitingSacrifice == true then
        return false, "Waiting for sacrifice submit"
    end

    local machineConfirmed =
        AgeBreakerState.MachineRunning == true
        or (
            AgeBreakerState.TimerSeconds ~= nil
            and SafeNumber(AgeBreakerState.TimerSeconds, 0) > 0
            and AgeBreakerState.ClaimReady ~= true
        )

    if machineConfirmed ~= true then
        return false, "Machine is not confirmed running"
    end

    if SafeElapsed(AgeBreakerState.LastAutoTradeWorldTeleportAt) < 12 then
        return false, "Trade World teleport cooldown"
    end

    local teleportKey =
        BuildAgeBreakerMachineStartTeleportKey()

    if teleportKey ~= ""
    and AgeBreakerState.LastMachineStartTradeTeleportKey == teleportKey then
        return false, "Already teleported for this machine start"
    end

    local player =
        Players.LocalPlayer

    if not player then
        return false, "LocalPlayer missing"
    end

    AgeBreakerState.LastAutoTradeWorldTeleportAt =
        os.clock()

    AgeBreakerState.LastAutoActionAt =
        os.clock()

    AgeBreakerState.LastMachineStartTradeTeleportKey =
        teleportKey

    AgeBreakerState.Status =
        "Teleporting to Trade World"

    AgeBreakerState.NextAction =
        "Snipe/list while timer runs"

    QueueAgeBreakerSave(
        "auto teleport trade world machine start",
        true
    )

    if type(RefreshAgeBreakerUI) == "function" then
        pcall(RefreshAgeBreakerUI)
    end

    HolyNotify(
        "Age Breaker",
        tostring(reason or "Machine started. Teleporting to Trade World."),
        "send",
        4
    )

    local TeleportService =
        game:GetService("TeleportService")

    local ok, err =
        pcall(function()
            TeleportService:Teleport(
                TRADING_WORLD_PLACE_ID,
                player
            )
        end)

    if not ok then

        AgeBreakerState.Status =
            "Trade World teleport failed"

        AgeBreakerState.NextAction =
            "Retry Trade World teleport"

        HolyNotify(
            "Age Breaker",
            tostring(err),
            "triangle-alert",
            4
        )

        return false, tostring(err)
    end

    return true, "Trade World teleport requested"
end

