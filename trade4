    end

    local parsed =
        RefreshManualJoinHUDValidation()

    if not parsed then
        return false
    end

    if not IsHolyAllowedJoinPlace(parsed.PlaceId) then
        return false
    end

    local joined =
        JoinParsedServer(parsed)

