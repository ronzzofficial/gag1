            ):gsub("%.0k", "k")
        end

        return tostring(number)
    end

    local function ShortenText(text, maxLength)

        text =
            tostring(text or "")

        maxLength =
            tonumber(maxLength)
            or 18

        if #text <= maxLength then
            return text
        end

        return text:sub(1, maxLength - 1) .. "…"
    end

